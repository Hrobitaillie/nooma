# Serveur Flooow — variables d'environnement (copier en .env, non versionné).

# Port d'écoute du Node sur l'hôte. Le Caddy du container y proxy via
# host.containers.internal:<PORT> (.caddy-upstream). Défaut : 3010.
# PORT=3010

# Adresse d'écoute. 0.0.0.0 REQUIS pour être joignable depuis le container Podman
# via host.containers.internal. Le port brut doit rester derrière le pare-feu.
# HOST=0.0.0.0

# Racine de stockage des projets : <DATA_DIR>/<dossier>/<fichier>.flooow.json
# Défaut : ./data
# DATA_DIR=/srv/dev/flooow/data

# Origines autorisées (CORS) si on tape l'API en direct hors Caddy (dev).
# En prod tout passe par le même origin, laisser vide.
# DEV_ORIGINS=http://localhost:5173
